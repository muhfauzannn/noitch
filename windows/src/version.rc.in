#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @NOITCH_VERSION_COMMA@,0
 PRODUCTVERSION @NOITCH_VERSION_COMMA@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Noitch\0"
   VALUE "FileVersion", "@NOITCH_VERSION@.0\0"
   VALUE "ProductName", "Noitch\0"
   VALUE "ProductVersion", "@NOITCH_VERSION@\0"
   VALUE "OriginalFilename", "Noitch.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
